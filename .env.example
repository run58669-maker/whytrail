# Copy to .env (never commit it). SAMPLE_MODE=true runs fully offline.
SAMPLE_MODE=false

# Model (injected generator). Default model: claude-opus-5-5
ANTHROPIC_API_KEY=your-anthropic-key
WHYTRAIL_MODEL=claude-opus-5-5
WHYTRAIL_MAX_COST_USD=1.0

# Zetaris direct REST (create the key yourself in the Zetaris UI: Management -> API Tokens)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-key

# H-MEM store (Meterless) persisted across runs
WHYTRAIL_MEMORY=.whytrail/hmem.json
PORT=8000
